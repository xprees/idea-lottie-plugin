<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cz.xprees.lottie</id>
    <name>Lottie</name>
    <vendor url="https://github.com/xprees">xprees</vendor>
    <!-- <description> and <change-notes> are filled in from README.md / CHANGELOG.md by the Gradle build -->

    <depends>com.intellij.modules.platform</depends>
    <!-- Lottie .json files stay JSON files; the Lottie features build on the JSON plugin -->
    <depends>com.intellij.modules.json</depends>
    <!-- The preview's embedded browser. Part of the platform in 2026.1 and 2026.2; from 2026.3 a separate bundled plugin
         ("Web Browser (JCEF)") whose classes a plugin only sees when it depends on it. Optional, so the plugin also loads where
         JCEF is missing; the preview then shows a notice. -->
    <depends optional="true" config-file="lottie-jcef.xml">com.intellij.modules.jcef</depends>
    <!-- Rider's Solution Explorer has its own popup group instead of ProjectViewPopupMenu -->
    <depends optional="true" config-file="lottie-rider.xml">com.intellij.modules.rider</depends>

    <resource-bundle>messages.LottieBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- .lottie: dotLottie archives, opened in the preview only -->
        <fileType name="dotLottie" implementationClass="cz.xprees.lottie.lang.DotLottieFileType" fieldName="INSTANCE"
                  extensions="lottie"/>
        <!-- Lottie .json files: recognized by name (*.lottie.json) or content, they keep the JSON file type -->
        <fileIconProvider implementation="cz.xprees.lottie.lang.LottieFileIconProvider" order="first"/>
        <fileEditorProvider implementation="cz.xprees.lottie.preview.LottieJsonEditorProvider"/>
        <fileEditorProvider implementation="cz.xprees.lottie.preview.DotLottieEditorProvider"/>

        <colorProvider implementation="cz.xprees.lottie.editor.LottieColorProvider"/>
        <codeInsight.declarativeInlayProvider language="JSON"
                                              implementationClass="cz.xprees.lottie.editor.LottieInlayHintsProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP" providerId="cz.xprees.lottie.hints"
                                              bundle="messages.LottieBundle" nameKey="inlay.provider.name"
                                              descriptionKey="inlay.provider.description"/>

        <!-- dotLottie state machines opened as JSON from a .lottie file -->
        <localInspection language="JSON" shortName="LottieStateMachineReferences" bundle="messages.LottieBundle"
                         key="inspection.sm.references.name" groupKey="inspection.group.name"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="cz.xprees.lottie.statemachine.StateMachineReferencesInspection"/>

        <notificationGroup id="Lottie" displayType="BALLOON" key="notification.group.name"/>
        <editorNotificationProvider implementation="cz.xprees.lottie.actions.DotLottieV1NotificationProvider"/>
        <editorTabTitleProvider implementation="cz.xprees.lottie.actions.DotLottieTabTitleProvider"/>
        <applicationConfigurable parentId="language" id="cz.xprees.lottie.settings"
                                 instance="cz.xprees.lottie.settings.LottieConfigurable"
                                 key="settings.display.name" bundle="messages.LottieBundle"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="cz.xprees.lottie.editor.LottieJsonSchemaProviderFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.json">
        <customStructureViewFactory implementation="cz.xprees.lottie.editor.LottieStructureViewFactory"/>
    </extensions>

    <actions>
        <action id="cz.xprees.lottie.ExtractAnimation" class="cz.xprees.lottie.actions.ExtractAnimationAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="ProjectViewPopupMenuModifyGroup"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="cz.xprees.lottie.PackDotLottie" class="cz.xprees.lottie.actions.PackDotLottieAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="cz.xprees.lottie.ExtractAnimation"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="cz.xprees.lottie.OptimizeLottie" class="cz.xprees.lottie.actions.OptimizeLottieAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="cz.xprees.lottie.PackDotLottie"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="cz.xprees.lottie.MigrateDotLottie" class="cz.xprees.lottie.actions.MigrateDotLottieAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="cz.xprees.lottie.PackDotLottie"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
